# Zerodha Kite Connect
KITE_API_KEY=your_api_key
KITE_API_SECRET=your_api_secret
KITE_ACCESS_TOKEN=your_access_token

# Database
DATABASE_URL=postgresql+asyncpg://trader:tradersecret@localhost:5432/fnotrading
DB_PASSWORD=tradersecret

# Redis
REDIS_URL=redis://localhost:6379/0

# Telegram Notifications
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# Risk Limits
MAX_DAY_LOSS=15000
MAX_STRATEGY_LOSS=5000
MAX_TOTAL_LOTS=50

# Application
LOG_LEVEL=INFO
ENVIRONMENT=development
API_SECRET_KEY=your_api_secret_key
PAPER_TRADING=true

# Strategies to auto-start (JSON array)
# STRATEGIES=[{"name":"short_strangle","id":"nifty_strangle_1","params":{"underlying":"NIFTY","quantity_lots":1}}]

# ─── Cold storage (DATA_RELIABILITY_PLAN §3.3) ──────────────────────────────
# scripts/upload_to_b2.py picks its backend from ARCHIVE_REMOTE:
#   - unset / b2     → real Backblaze B2 (requires B2_KEY_ID + B2_APP_KEY + B2_BUCKET)
#   - local-dir:<p>  → write to local dir <p>; used by tests + `make cold-storage`
# Leave ARCHIVE_REMOTE unset on prod — the uploader fails loud if `b2` is
# selected and creds are missing (a cron that silently uploads nothing for
# six weeks is the failure mode the whole chain exists to prevent).
# ARCHIVE_REMOTE=b2
# B2_KEY_ID=your_b2_application_key_id
# B2_APP_KEY=your_b2_application_key
# B2_BUCKET=fnotrading-cold-archive
