# Backfill artifacts — regeneratable from scripts/backfill_day_bias.py
data/day_bias_backfill/

# Quarantined chain snapshots — large simulator-generated CSVs kept for
# forensic inspection only. Track the README so the audit trail lives in
# git, but the CSVs themselves are not source-of-truth data.
data/chain_snapshots/_quarantine/*.csv
data/chain_snapshots/_quarantine/*.csv.*

# Pre-clean backups from scripts/clean_holiday_minutes.py — kept on disk
# for one-off forensic inspection; not source-of-truth data.
data/*.dirty-*.csv

# Daemon runtime artifacts — recreated on every start, no audit value
.fno_main.pid
data/heartbeat/
data/replay_runs.jsonl

# GDFL real-tick validation artifacts (derived data, ~13 MB)
data/gdfl_snapshots/
data/backtest_runs/
data/backtest_logs/

# Recorded chain snapshots — daily growth, kept locally for analysis but
# not suitable for git (binary-like CSV bloat). The truth-up scripts
# regenerate analysis from these on demand.
data/chain_snapshots/

# Decision logs — per-day CSV trail of strategy decisions, grows daily
# during paper/live trading. Already de-duplicated post Apr 25 audit
# Bug 4 fix; logs are valuable as live trail but not as repo artifact.
data/decisions/

# Recorded VIX minute history — daily-growth IV reference data
data/india_vix_recorded/

# Per-tick capture for backtest replay
data/ticks/

# Latest audit JSON — regenerated on every nightly_audit.py run
data/latest_audit.json

# Validation profiling artifacts (from cProfile / py-spy runs)
reports/validation/*.pstats
reports/validation/*.bak
reports/validation/profile_*.txt

# Claude Code project metadata (worktrees, session caches)
.claude/
