<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  launchd job: bounce the FnO trading daemon at 08:50 IST every weekday so the
  one-shot holiday guard in src/main.py:830 re-evaluates against today's date.

  Install:
      cp scripts/com.fno.daemon-restart.plist ~/Library/LaunchAgents/
      launchctl load ~/Library/LaunchAgents/com.fno.daemon-restart.plist

  Uninstall:
      launchctl unload ~/Library/LaunchAgents/com.fno.daemon-restart.plist
      rm ~/Library/LaunchAgents/com.fno.daemon-restart.plist

  Inspect schedule:
      launchctl list | grep fno
      launchctl print gui/$UID/com.fno.daemon-restart

  Trigger manually (for smoke tests):
      launchctl start com.fno.daemon-restart

  StartCalendarInterval times are in the host's local timezone. This Mac is
  Asia/Kolkata, so 08:50 fires at 08:50 IST — 25 minutes before market open.
  NSE-holiday filtering happens inside restart_daemon.sh.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.fno.daemon-restart</string>

    <!-- Script lives in ~/Library/Application Support/, NOT ~/Documents/.
         macOS Tahoe TCC denies launchd-spawned bash from reading scripts
         under ~/Documents/ even with /bin/bash granted Full Disk Access
         (SIP-protected binaries don't honor FDA for protected user dirs).
         The bootstrap script outside Documents/ sidesteps the gate;
         spawned children (uv, python) inherit FDA from bash's process.
         Sync via: cp scripts/restart_daemon.sh \
                      "$HOME/Library/Application Support/fno-trading/restart-daemon.sh"
         (or run `make deploy-launchd` once that target lands). -->
    <key>ProgramArguments</key>
    <array>
        <string>/Users/kundanbora/Library/Application Support/fno-trading/restart-daemon.sh</string>
    </array>

    <!-- Mon (1) through Fri (5) at 09:02 IST local time.
         V7.3 (May 19 2026): shifted from 08:50 → 09:02 to ensure daemon
         starts AFTER the 08:55 daily auto-auth completes. Prior 08:50
         start caused the daemon to boot with token T0; auto-auth at
         08:55 refreshed to T1 but the running KiteTicker kept T0 in
         its handshake state, producing the morning reconnect-loop bug
         (May 13, May 18). Starting at 09:02 means the fresh daemon
         picks up T1 from .env at construction. 13-minute buffer before
         09:15 market open gives WebSocket time to fully establish. -->
    <key>StartCalendarInterval</key>
    <array>
        <dict>
            <key>Weekday</key><integer>1</integer>
            <key>Hour</key><integer>9</integer>
            <key>Minute</key><integer>2</integer>
        </dict>
        <dict>
            <key>Weekday</key><integer>2</integer>
            <key>Hour</key><integer>9</integer>
            <key>Minute</key><integer>2</integer>
        </dict>
        <dict>
            <key>Weekday</key><integer>3</integer>
            <key>Hour</key><integer>9</integer>
            <key>Minute</key><integer>2</integer>
        </dict>
        <dict>
            <key>Weekday</key><integer>4</integer>
            <key>Hour</key><integer>9</integer>
            <key>Minute</key><integer>2</integer>
        </dict>
        <dict>
            <key>Weekday</key><integer>5</integer>
            <key>Hour</key><integer>9</integer>
            <key>Minute</key><integer>2</integer>
        </dict>
    </array>

    <!-- Don't fire on `launchctl load` — only on the calendar trigger. -->
    <key>RunAtLoad</key>
    <false/>

    <!-- V7.4 (May 22 2026): the daemon now handles its own dead-reactor
         recovery via os.execv() inside TickerManager. No launchd
         KeepAlive needed — execv replaces the process image in-place
         (same PID + PPID, fresh Python interpreter + fresh Twisted
         reactor). The 09:02 IST calendar trigger remains the only
         launchd restart hook, used for daily token refresh + clean
         state. Intermittent reactor-dead recoveries happen entirely
         within the daemon's own process lifecycle.

         Why os.execv() over launchd KeepAlive: the daemon is a
         GRANDCHILD of launchd (double-fork pattern in restart_daemon.sh)
         so launchd KeepAlive cannot track it. execv keeps the .pid
         file valid and avoids race conditions. -->


    <!-- macOS TCC: launchd-spawned processes are denied ~/Documents/ access
         by default. SessionCreate=true makes the job run in an Aqua-like
         session that inherits the user's TCC grants. If this still fails
         with exit 126, grant /bin/bash Full Disk Access in
         System Settings → Privacy & Security → Full Disk Access. -->
    <key>SessionCreate</key>
    <true/>

    <!-- Capture script stdout/stderr for forensics if a restart misfires. -->
    <key>StandardOutPath</key>
    <string>/Users/kundanbora/Documents/FnOTrading/logs/restart_daemon.stdout.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/kundanbora/Documents/FnOTrading/logs/restart_daemon.stderr.log</string>

    <!-- launchd's default PATH is minimal; uv is invoked by absolute path
         inside the script, so this is belt-and-braces only. -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>
</dict>
</plist>
